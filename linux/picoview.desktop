[Desktop Entry]
Type=Application
Name=PicoView
GenericName=Image Viewer
Comment=Fast, small image viewer
Exec=picoview %f
Icon=picoview
Terminal=false
Categories=Graphics;Viewer;2DGraphics;
MimeType=image/jpeg;image/png;image/bmp;image/gif;image/x-targa;image/x-portable-pixmap;image/x-portable-graymap;
NoDisplay=false
